# Copy to .env and fill in. .env is gitignored and must stay that way.

# Postgres. On the VPS this should be a database and role dedicated to this
# service -- not the CRM's role. A bug here must not be able to read the CRM.
DATABASE_URL=postgres://normless_drive:CHANGEME@localhost:5432/normless_drive

# Origin that share links are built from. No trailing slash; one is trimmed
# anyway. Never derived from the request Host header, which is attacker
# controlled.
PUBLIC_BASE_URL=https://drive.normless.in

# nginx proxies to this. Loopback only -- the app must not be directly
# reachable from the internet.
BIND_ADDR=127.0.0.1:8080

# The ONE address that is the administrator. Everyone else lands on
# 'pending' no matter who signs up first.
#
# Set this before the site is reachable. The hostname is in public DNS, so
# without it there is either no admin at all, or -- under any "first signup
# wins" rule -- whichever stranger finds the site first.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Creates that account at startup if it does not already exist, so there is
# no need to register through the UI. Used ONCE: if the account exists this
# value is ignored, and it will never reset an existing password.
#
# This is plaintext on disk for as long as it is set. Sign in, change the
# password from the app, then delete this line and restart. The server logs
# a reminder on every boot until you do.
BOOTSTRAP_ADMIN_PASSWORD=choose-a-long-one-at-least-12-chars

# Login session lifetime. 336 = 14 days.
SESSION_TTL_HOURS=336

# Set false only when developing over plain http://localhost, otherwise the
# browser will refuse to store the session cookie.
COOKIE_SECURE=true

# RUST_LOG=info,sqlx=warn
