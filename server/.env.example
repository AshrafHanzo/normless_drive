# Copy to .env and fill in. .env is gitignored and must stay that way.

# Postgres. On the VPS this should be a database and role dedicated to this
# service -- not the CRM's role. A bug here must not be able to read the CRM.
DATABASE_URL=postgres://normless_drive:CHANGEME@localhost:5432/normless_drive

# Origin that share links are built from. No trailing slash; one is trimmed
# anyway. Never derived from the request Host header, which is attacker
# controlled.
PUBLIC_BASE_URL=https://drive.normless.in

# nginx proxies to this. Loopback only -- the app must not be directly
# reachable from the internet.
BIND_ADDR=127.0.0.1:8080

# Login session lifetime. 336 = 14 days.
SESSION_TTL_HOURS=336

# Set false only when developing over plain http://localhost, otherwise the
# browser will refuse to store the session cookie.
COOKIE_SECURE=true

# RUST_LOG=info,sqlx=warn
